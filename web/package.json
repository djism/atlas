{
  "name": "atlas-sandbox",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Interactive sandbox running the Atlas C++ localization engine in the browser via WebAssembly.",
  "scripts": {
    "build:wasm": "bash ../wasm/build.sh",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.169.0"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.169.0",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
